{
  "name": "a2ui-angular",
  "version": "1.0.0",
  "description": "Angular 19 SSR + Genkit + OpenRouter/Claude 全栈应用",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "mock": "ng build && cross-env MOCK_LLM=1 node dist/app/server/server.mjs",
    "mock:dev": "cross-env MOCK_LLM=1 ng serve",
    "mock:ssr": "cross-env MOCK_LLM=1 node dist/app/server/server.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:app": "node dist/app/server/server.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "start:with-genkit-ui": "ng build && cross-env NO_PROXY=localhost,127.0.0.1 genkit start -- node dist/app/server/server.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.2.0",
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/material": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/platform-server": "^19.2.0",
    "@angular/router": "^19.2.0",
    "@angular/ssr": "^19.2.26",
    "@genkit-ai/compat-oai": "^1.36.0",
    "@genkit-ai/express": "^1.36.0",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "genkit": "^1.36.0",
    "ioredis": "^5.11.0",
    "partial-json": "^0.1.7",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "undici": "^8.3.0",
    "zod": "^3.24.2",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.26",
    "@angular/cli": "^19.2.26",
    "@angular/compiler-cli": "^19.2.0",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^18.18.0",
    "cross-env": "^10.1.0",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.7.2"
  }
}
